{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "scripts": {
  "dev": "vite --host 0.0.0.0 --port 5173",
  "dev:vercel": "vercel dev --listen 5173",
  "build": "tsc -b && vite build",
  "preview": "vite preview"
}
}
